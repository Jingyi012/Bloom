# In development, Bloom maps localhost to the Expo host automatically.
EXPO_PUBLIC_API_URL=http://localhost:5052/api/v1
# Set true only when the configured URL must be used exactly as written.
EXPO_PUBLIC_STRICT_BASE_URL=false
# Optional fallback for a physical device when Expo cannot detect the PC host.
# EXPO_PUBLIC_DEV_HOST=192.168.1.20
# Native builds must use the client matching the platform application.
# Do not put the Web client ID in either native variable.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# Optional: only needed when running the web target.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
