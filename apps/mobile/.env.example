# iOS simulator: http://127.0.0.1:5052/api/v1
# Android emulator: http://10.0.2.2:5052/api/v1
EXPO_PUBLIC_API_URL=http://127.0.0.1:5052/api/v1
# Native builds must use the client matching the platform application.
# Do not put the Web client ID in either native variable.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# Optional: only needed when running the web target.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
