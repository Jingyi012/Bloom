{
  "expo": {
    "name": "Bloom",
    "slug": "bloom",
    "version": "0.1.0",
    "icon": "./assets/bloom-icon.png",
    "orientation": "portrait",
    "scheme": "com.bestfriends.bloom",
    "platforms": [
      "ios",
      "android"
    ],
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image-picker",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FCF8F4",
          "image": "./assets/bloom-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bestfriends.bloom"
    },
    "android": {
      "package": "com.bestfriends.bloom",
      "adaptiveIcon": {
        "foregroundImage": "./assets/bloom-icon.png",
        "backgroundColor": "#FCF8F4"
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "12970537-412f-42f9-b8dd-2d464566160f"
      }
    }
  }
}
