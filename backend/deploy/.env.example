# GitHub Container Registry owner, normally the lowercase GitHub username/org.
IMAGE_OWNER=your-github-owner
BACKEND_IMAGE_TAG=latest

# Google OAuth client IDs accepted by the API. These values are not passwords,
# but should still be configured per environment. At least one is required.
Google__IosClientId=replace-with-ios-client-id
Google__AndroidClientId=replace-with-android-client-id
Google__WebClientId=replace-with-web-client-id

# Application session settings. Use a random secret of at least 32 characters.
Bloom__SessionIssuer=Bloom.Api
Bloom__SessionSigningKey=replace-with-a-random-secret-at-least-32-characters
Bloom__AccessTokenMinutes=15
Bloom__RefreshTokenDays=30

# Use a strong value and keep this file private on the server.
POSTGRES_DB=bloom
POSTGRES_USER=bloom
POSTGRES_PASSWORD=replace-with-a-strong-password

# Absolute host path for PostgreSQL data. The directory is mounted at
# /var/lib/postgresql/data inside the PostgreSQL container.
POSTGRES_DATA_PATH=/opt/bloom-uat/postgresql/data

# Absolute path on the deployment server. This is mounted as /data/uploads
# and is used by ImageStorage:RootPath inside the container.
BLOOM_UPLOADS_PATH=/srv/bloom/uploads

# Application settings are supplied using the same environment-key format as
# appsettings.json. Keep migrations disabled unless intentionally migrating.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
ImageStorage__RootPath=/data/uploads
# Maximum size of each uploaded image in bytes (10 MiB).
ImageStorage__MaxBytes=10485760
Bloom__ApplyMigrationsOnStartup=false

# Host bind address and port for the API.
API_BIND_HOST=127.0.0.1
API_HOST_PORT=28100

# PostgreSQL host access. Restrict this with a firewall; use 127.0.0.1 and an
# SSH tunnel instead if external access is not required.
DB_BIND_HOST=0.0.0.0
DB_HOST_PORT=28101
